{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "@shared/*": ["packages/shared/src/*"],
      "@latex-core/*": ["packages/latex-core/src/*"],
      "@ai-core/*": ["packages/ai-core/src/*"],
      "@md-to-latex/*": ["packages/md-to-latex/src/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*", "packages/**/*", "electron.vite.config.ts"],
  "exclude": ["node_modules", "out", "dist", "docs", "e2e"]
}
