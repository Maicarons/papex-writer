{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "@shared/*": ["packages/shared/src/*"],
      "@latex-core/*": ["packages/latex-core/src/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*", "packages/**/*", "e2e/**/*"],
  "exclude": ["node_modules", "dist", "dist-electron", "docs"]
}
